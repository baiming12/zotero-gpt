<?xml version="1.0" encoding="UTF-8"?>
<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:em="http://www.mozilla.org/2004/em-rdf#">
  <Description about="urn:mozilla:install-manifest">
    <em:id>zoterogpt@polygon.org</em:id>
    <em:name>Zotero GPT</em:name>
    <em:version>0.2.8</em:version>
    <em:description>A Zotero plugin to summarize abstracts using Grok 3 API</em:description>
    <em:creator>Polygon</em:creator>
    <em:homepageURL>https://github.com/MuiseDestiny/zotero-gpt</em:homepageURL>
    <em:targetApplication>
      <Description>
        <em:id>{ec8030f7-c20a-464f-9b0e-13a3a9e97384}</em:id>
        <em:minVersion>6.0</em:minVersion>
        <em:maxVersion>7.0.*</em:maxVersion>
      </Description>
    </em:targetApplication>
    <em:bootstrap>true</em:bootstrap>
    <em:unpack>false</em:unpack>
  </Description>
</RDF>